ML_SERVICE_PORT=5001
FLASK_DEBUG=true

# Origin(s) allowed to call this service (the Node/Express backend, not the browser)
CORS_ORIGIN=http://localhost:5000

# Optional shared secret. If set, callers must send it as X-Internal-Api-Key.
# Set the same value as ML_SERVICE_API_KEY in backend/.env.
ML_SERVICE_API_KEY=

# Optional: directory holding the yield model artifacts (model.joblib + metadata.json).
# Defaults to models/yield_prediction. If the files are missing, the yield endpoints return 503 (never a fake number).
YIELD_MODEL_DIR=
