# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/geo_rural_intelligence

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ML service (Flask). Used by Crop Recommendation (Phase 3) and later Yield Prediction.
# Use 127.0.0.1 rather than localhost: on Windows/Node 18+ localhost can resolve to IPv6 (::1) while Flask listens on IPv4.
ML_SERVICE_URL=http://127.0.0.1:5001
# Max time to wait for the ML service before returning a 504 to the client
ML_SERVICE_TIMEOUT_MS=8000
# Optional shared secret; must equal ML_SERVICE_API_KEY in ml-service/.env if set there
ML_SERVICE_API_KEY=

# FRA Monitoring (Phase 5)
# How long a verified reference ID stays valid for viewing the claim (seconds)
FRA_GRANT_TTL_SECONDS=600
# Failed reference-ID attempts allowed per farmer inside the window before HTTP 429
FRA_VERIFY_MAX_FAILURES=8
FRA_VERIFY_WINDOW_MINUTES=15

# Development seed only (npm run seed:demo-fra): the password given to the DEMO farmer and government
# official accounts it creates. Optional; defaults to a built-in demo value. Never used in production.
DEMO_SEED_PASSWORD=
